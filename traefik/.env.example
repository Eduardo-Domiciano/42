# Portas no docker-compose.yml deste diretório: 80:80 e 443:443
# (não use 80:8080 — 8080 era o publish antigo do app no host)

# E-mail do Let's Encrypt (HTTPS / dashboard)
ACME_EMAIL=voce@exemplo.com

# Host do dashboard Traefik (precisa DNS se for usar HTTPS no painel)
TRAEFIK_DASHBOARD_HOST=traefik.seudominio.com


# Usuário do dashboard — gere com:
#   htpasswd -nb admin 'senha-forte'
# Cole o resultado inteiro (user:hash). Escape $ como $$ se colar no compose.
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$troque$$estehash

# Recursos (teto: 1/4 core + 1 GiB). Ex.: VPS com 4 vCPU → TRAEFIK_CPUS=1.0
TRAEFIK_CPUS=0.25
TRAEFIK_MEMORY=1G

# Anti brute-force / flood (por IP)
TRAEFIK_RATE_AVERAGE=20
TRAEFIK_RATE_BURST=40
TRAEFIK_INFLIGHT=40
