# Copie: cp -n .env.example .env && nano .env
# Ou configure as mesmas vars no ../.env da raiz do 42.

ACME_EMAIL=voce@exemplo.com
TRAEFIK_DASHBOARD_HOST=traefik.localhost

# Login = texto antes de ":". Senha = o que você passou no htpasswd (não o hash).
# Gere:  htpasswd -nb admin 'sua-senha'
# No .env dobre cada $ → $$
# Ex. htpasswd devolve admin:$apr1$xxx$yyy
#     no .env:     admin:$$apr1$$xxx$$yyy
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$rvDOX4OX$$I1Yhwm7OpZRkDzpiGASR0/

TRAEFIK_CPUS=0.25
TRAEFIK_MEMORY=1G
TRAEFIK_RATE_AVERAGE=20
TRAEFIK_RATE_BURST=40
TRAEFIK_INFLIGHT=40
