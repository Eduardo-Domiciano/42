# Backend / docker-compose
DATABASE_URL=sqlite:////data/veracidade.db
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4200,http://127.0.0.1:4200

# Traefik dashboard (basic auth) — só estas linhas importam para o painel:
#   URL: http://IP:8080/dashboard/   (porta 8080, não a 80)
#   Firewall: liberar TCP 8080
ACME_EMAIL=noreply@localhost
TRAEFIK_DASHBOARD_HOST=traefik.localhost
# htpasswd -nb -m admin 'senha' → no .env dobre cada $ → $$
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$04xB3LGc$$oZTHFNdch9T/d7zZk30hq/

# HTTPS com domínio:
# DOMAIN=app.seudominio.com
# CORS_ORIGINS=https://app.seudominio.com

# Só local sem Traefik: docker compose up  →  :8080
# HOST_PORT=8080


# Limites do app (¼ core + 1 GiB)
# APP_CPUS=0.25
# APP_MEMORY=1G

# LLM desligada por padrão (heurísticas para claims, relevância e resumo)
LLM_PROVIDER=none
CLAIM_USE_LLM=false
TOPIC_RELEVANCE_USE_LLM=false
NARRATIVE_USE_LLM=false

# Busca por tema
TOPIC_SEARCH_MAX_RESULTS=12
TOPIC_SEARCH_WEB_CANDIDATES=14
TOPIC_MIN_RELEVANCE=0.30
TOPIC_SOFT_RELEVANCE=0.20
TOPIC_MIN_SEMANTIC=0.48
TOPIC_MIN_LEXICAL_FOR_SEMANTIC=0.26
TOPIC_REQUIRE_PUBLISHED_AT_IN_RANGE=true

# F4
CROSSREF_ENABLED=true
CROSSREF_MAX_PEERS=6
CROSSREF_USE_LLM_STANCE=false

# Redes neurais locais (complemento; exige pip install -r requirements-nn.txt)
NN_ENABLED=true
NN_NLI_ENABLED=true
NN_EMBEDDINGS_ENABLED=true
NN_CLICKBAIT_ENABLED=true
