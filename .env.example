# Backend / docker-compose
DATABASE_URL=sqlite:////data/veracidade.db
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4200,http://127.0.0.1:4200

# F3 — OpenRouter (opcional; sem chave usa heurísticas)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
CLAIM_USE_LLM=true
CLAIM_LLM_MAX_PER_TOPIC=3

# Busca por tema (filtro de relevância)
TOPIC_SEARCH_MAX_RESULTS=12
TOPIC_SEARCH_WEB_CANDIDATES=32
TOPIC_MIN_RELEVANCE=0.32
TOPIC_MIN_SEMANTIC=0.48
TOPIC_MIN_LEXICAL_FOR_SEMANTIC=0.28
TOPIC_REQUIRE_PUBLISHED_AT_IN_RANGE=true

# F4
CROSSREF_ENABLED=true
CROSSREF_MAX_PEERS=6
CROSSREF_USE_LLM_STANCE=false

# Redes neurais locais (complemento; exige pip install -r requirements-nn.txt)
NN_ENABLED=true
NN_NLI_ENABLED=true
NN_EMBEDDINGS_ENABLED=true
NN_CLICKBAIT_ENABLED=true
# NN_NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
# NN_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

