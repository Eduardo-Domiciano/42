# Copie para a VPS (fora do clone do Actions):
#   cp 42.cd.env.example ~/42.cd.env
#   nano ~/42.cd.env
#
# CD padrão: Traefik + app → http://IP/
# Sem este arquivo também funciona (defaults do Traefik).

# CORS_ORIGINS=http://SEU_IP,http://127.0.0.1

# HTTPS:
# DOMAIN=app.seudominio.com
# CORS_ORIGINS=https://app.seudominio.com

# Traefik (opcional; senão usa defaults / traefik/.env):
# ACME_EMAIL=voce@exemplo.com
# TRAEFIK_DASHBOARD_HOST=traefik.seudominio.com
