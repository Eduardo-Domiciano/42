# Copie para a VPS (fora do clone do Actions):
#   cp 42.cd.env.example ~/42.cd.env
#   nano ~/42.cd.env
#
# Sem domínio: deixe DOMAIN comentado (ou arquivo vazio / inexistente).
# O CD sobe em http://IP:8080 (ou HOST_PORT).

# --- Modo IP (padrão se não houver DOMAIN) ---
# HOST_PORT=8080
# CORS_ORIGINS=http://SEU_IP:8080,http://127.0.0.1:8080

# --- Modo domínio + Traefik/HTTPS ---
# DOMAIN=app.seudominio.com
# CORS_ORIGINS=https://app.seudominio.com
